# Server
PORT=3001
HOST=0.0.0.0

# SQLite database file. Defaults to server/flightlogger.db for local dev.
# In production (Fly) this is set to /data/flightlogger.db on the mounted volume.
# DB_PATH=/data/flightlogger.db

# Basic auth — when both set, all routes require these credentials.
# Leave unset for local dev to skip the auth prompt.
# AUTH_USER=
# AUTH_PASS=

# Optional: directory for nightly SQLite backups (7-day retention).
# Set in production; unset locally to disable.
# BACKUP_DIR=/data/backups

# Optional: serve the built React client from Express (default true).
# Set to "false" when running Vite separately during local dev.
# SERVE_CLIENT=false

# Optional: override the path to the built client (defaults to ../dist relative to server).
# CLIENT_DIST=/app/dist
